      "mockObservations": [
        {"clipId":"clip_roof_a","characterId":"character_nia","timeSeconds":1.2,"attributes":{"hair":{"expected":"short coiled black hair","observed":"short coiled black hair","visibility":"clear"},"jacket":{"expected":"green work jacket","observed":"green work jacket","visibility":"clear"},"wateringCan":{"expected":"held by Nia","observed":"visible in Nia's hand","visibility":"clear"}}},
        {"clipId":"clip_roof_b","characterId":"character_nia","timeSeconds":2.4,"attributes":{"hair":{"expected":"short coiled black hair","observed":"short coiled black hair","visibility":"clear"},"jacket":{"expected":"green work jacket; wet variation allowed","observed":"wet green work jacket","visibility":"clear"},"wateringCan":{"expected":"held at scene start","observed":"visible in Nia's hand","visibility":"clear"}}}
      ],
      "mockEvaluator": {"mode":"return-observations","findings":[{"category":"visual.appearance.hair","state":"consistent","severity":"info","characterId":"character_nia","clipId":"clip_roof_a","expected":"short coiled black hair","observed":"short coiled black hair","timeSeconds":1.2,"confidence":0.94},{"category":"visual.appearance.jacket","state":"consistent","severity":"info","characterId":"character_nia","clipId":"clip_roof_b","expected":"wet green jacket is allowed","observed":"wet green work jacket","timeSeconds":2.4,"confidence":0.91}]},
      "expected": {"reportStatus":"complete","providerCallCount":1,"findingStates":["consistent","consistent"],"stale":false}
    },
