      "mockEvaluator": {"mode":"return-findings","findings":[{"category":"visual.appearance.hair","state":"consistent","severity":"info","characterId":"character_nia","clipId":"clip_roof_b","expected":"short coiled black hair","observed":"short coiled black hair","evidence":[{"assetId":"asset_clip_b","timeSeconds":2.0}],"confidence":0.9}]},
