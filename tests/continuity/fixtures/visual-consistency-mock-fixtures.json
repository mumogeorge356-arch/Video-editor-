      "title": "Baseline consistent character across clips",
      "selectedClipIds": ["clip_roof_a", "clip_roof_b"],
      "selectedReferenceAssetIds": ["asset_ref_nia_front"],
      "consent": {"remoteAnalysis": true, "providerId": "test.mock-vision"},
